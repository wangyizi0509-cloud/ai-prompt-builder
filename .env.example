# LLM 配置
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 思考模式 + 工具调用（V3.2 新特性）
# 启用后，模型在调用工具时也会进行思考推理
# 注意：启用后会使用 deepseek-chat + thinking:enabled，而非 deepseek-reasoner
DEEPSEEK_THINKING_WITH_TOOLS=false
# 思考模式下工具调用的最大轮次（防止死循环）
DEEPSEEK_THINKING_MAX_ROUNDS=15

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Claude API (备选)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-20250514

# 豆包 (Volcengine Ark) 配置
DOUBAO_API_KEY=your_doubao_api_key
DOUBAO_ENDPOINT_ID=your_endpoint_id
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# LangSmith 配置（用于调试和监控）
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=crushe-agent-debug
LANGSMITH_TRACING=true

# LangGraph Cloud 配置
# DEBUG_MODE=0 使用 LangGraph Cloud
DEBUG_MODE=0

# 远端部署环境配置
LANGGRAPH_CLOUD_URL=https://your-deployment-id.us.langgraph.app
LANGGRAPH_CLOUD_API_KEY=your_langgraph_api_key
LANGGRAPH_CLOUD_ASSISTANT_ID=crushe_agent

# Supabase 配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT 密钥配置
JWT_SECRET=your_jwt_secret_key

# PostgreSQL 数据库配置 (Checkpointer)
DATABASE_URL=postgresql://user:password@host:port/database

# 上下文维护配置
# 1 = 同步执行提纯任务 (适用于 Studio/调试)
# 0 = 异步入队执行 (适用于生产)
STUDIO_SYNC_MAINTENANCE=0
