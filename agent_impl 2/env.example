# LLM 配置
# 支持: deepseek, openai, claude
LLM_PROVIDER=deepseek

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI API (备选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Claude API (备选)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# 豆包 (Volcengine Ark) 配置
# API Key 申请地址: https://console.volcengine.com/ark/region:home/api-key
DOUBAO_API_KEY=your_api_key_here
# 推理接入点 ID 申请地址: https://console.volcengine.com/ark/region:home/endpoint
DOUBAO_ENDPOINT_ID=ep-xxxx-xxxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3


